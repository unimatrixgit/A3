#include "turret.odf"

//**********************************************************************
//MAIN DESIGN PARAMETERS

//Name of Ship class in Ship Display window & in edit mode & tooltip
unitName = "Mine"

// Do not change!  If you want it to seek and destroy and all that.
aiName = "MineProcess"

//Runtime class label for instantiation of object.
classLabel = "minearray"

//tooltips
tooltip = "8472_MINE"
verboseTooltip = "8472_MINE_V"

//Race which can build ship & starting race of ship
race = "species8472"

// This ship is built from another ship, not a starbase (used by AIP build lists)
// NO THIS IS BUILT BY RIGS shipIsBuiltByShips = 1

//Amount of time required to build ship

//Number of officers required to build this ship

// amount of biomatter needed to build

//Max Shield Strength & Begining Shield Strength <1000
maxHealth = 1245

//Rate at which shield recharges (points per second... we think)
shieldRate = 4.1

//**********************************************************************
//AI system parameters
//These parameters influence how the AI evaluates and compares craft.

//An abstract number that represents how much extra strength must be
//used to attack this craft due to its weapons. 
// (0.0=no weapons, 0.5 = average weapons, 1.0=many good weapons)
attackPower = 0.50f

//The normalized intrinsic value of a target.  High value craft make good
//attack targets. (0.0=lowest value, 1.0=highest value)
intrinsicValue = 0.50f

//**********************************************************************
//SYSTEM HITPOINTS
//These values are the hitpoint values of the systems
//If the value is set to zero the ship does not have that system
weaponsHitPoints = 1

//**********************************************************************
//ART PARAMETERS & WEAPON NAMES

// Pulse Phaser
//weapon1 = "ctpulse"
//weaponHardpoints1 = "HP01" "HP02" "HP03"

// Hardpoints to hit for various systems and other locations.
enginesTargetHardpoints = "hp07" "hp08" "hp09" "hp10"
//lifeSupportTargetHardpoints = "hp01" "hp02" "hp03"
weaponsTargetHardpoints = "hp01"
shieldGeneratorTargetHardpoints = "hp02" "hp03" "hp04" "hp05"
sensorsTargetHardpoints = "hp04" "hp06" "hp08"
hullTargetHardpoints = "hp02" "hp04" "hp06" "hp08" "hp10"
criticalTargetHardpoints = "hp03" "hp05" "hp07" "hp09"

//**********************************************************************

// MineArray Parameters
detectRange = 800
// The drag of space
drag = 1
// Acceleration at 1 unit
acceleration = 10000
// How big of an explosion
destructRadius = 250
// How fast to head back home
returnSpeed = 20
// How close to home to start slowing down
slowdownDist = 100

// starting acceleration value
accelConst = 50.0

// Which self destruct explosion to use
selfDestruct = "xmineexplosion"

//**********************************************************************
//MESSAGE & SOUND PARAMETERS

eventSelect = "PhaserTurretSelect"
eventAcknowledge = "PhaserTurretAcknowledge"
eventAttack = "PhaserTurretAttack"
eventDecommission = "PhaserTurretDecommission"

//**********************************************************************
//KEYMAP LABEL
// Obsolete, use hotkeyLabel
// keymapLabel = "phaser_turret"
hotkeyLabel = "HOTKEY_F1"

//************************************************************
// Brian additions for context sensitive menus
alert = 0
combat = 0
SPECIES_MINE = 1

// this should not get added to the pathplanner
// it's going to move and explode eventually
addToPlanner = 0




// Xaramada resource costs: original filename.
dilithiumCost = 0
metalCost = 0
latinumCost = 0
biomatterCost = 200
crewCost = 0
officerCost = 0
buildTime = 25
