#include "station.odf"

//**********************************************************************
//MAIN DESIGN PARAMETERS

//Name of Ship class in Ship Display window & in edit mode & tooltip
unitName = "Transwarp Portal"

//tooltips
tooltip = "BORG_PORTAL"
verboseTooltip = "BORG_PORTAL_V"

//Race which can build ship & starting race of ship
race = "borg"

//Amount of time required to build ship

//Number of officers required to build this ship

//Number of crew required to build ship & Starting crew

//Number of maximum crew (only specified if different from crewCost)
maximumCrew = 3000

//Dilithium Cost to build

//Metal cost to build

//Max Shield Strength & Begining Shield Strength <1000
maxHealth = 10000

//Rate at which shield recharges (points per second... we think)
shieldRate = 8.5

shieldProtection = 1.0

//We're a transwarp gate! 
isTranswarpGate = 1;

//place the object below the combat area
moveBelowCombatArea = 0

//Possible Craft Names
possibleCraftNames = 
    "Transwarp Portal"

//**********************************************************************
//ART PARAMETERS & WEAPON NAMES

//Transwarp (wormhole generator)
//weapon1 = "gporthole"
//weaponHardpoints1 = "hp01"

// Hardpoints to hit for various systems and other locations.
enginesTargetHardpoints = "hp06" "hp07" "hp08" "hp09" "hp10"
lifeSupportTargetHardpoints = "hp11" "hp12" "hp13" "hp14" "hp15"
weaponsTargetHardpoints = "hp01" "hp02" "hp03" "hp04" "hp05"
shieldGeneratorTargetHardpoints = "hp16" "hp17" "hp18" "hp19" "hp20"
sensorsTargetHardpoints = "hp21" "hp22" "hp23" "hp24" "hp25"
hullTargetHardpoints = "hp06"
criticalTargetHardpoints = "hp01"

//**********************************************************************
//Construction Parameters

//Hardpoint location for building.
buildHardpoint = "hp01"

//**********************************************************************
//AI system parameters
//These parameters influence how the AI evaluates and compares craft.

//The normalized intrinsic value of a target.  High value craft make good
//attack targets. (0.0=lowest value, 1.0=highest value)
intrinsicValue = 1.50f

//**********************************************************************
//SYSTEM HITPOINTS
//These values are the hitpoint values of the systems
//If the value is set to zero the ship does not have that system
weaponsHitPoints = 1

//**********************************************************************
//SYSTEM DAMAGE DISTRIBUTION
//The following section's values should add up to 100
//Percent Chance out of 100 of engines being damaged
enginesHitPercent = 0.0f

//Percent Chance out of 100 of weapons being damaged
weaponsHitPercent = 0.0f

//Percent Chance out of 100 of life support being damaged
lifeSupportHitPercent = 10.0f

//Percent Chance out of 100 of crew being killed
crewHitPercent = 25.0f

//Percent Chance out of 100 of shields being damaged
shieldGeneratorHitPercent = 10.0f

//Percent Chance out of 100 of sensors being damaged
sensorsHitPercent = 15.0f

//Percent Chance out of 100 of hull being damaged
hullHitPercent = 40.0f

//**********************************************************************
//MESSAGE & SOUND PARAMETERS

eventSelect = "SuperblSelect"
eventAcknowledge = "SuperblAcknowledge"
eventDecommission = "SuperblDecommission"


//**********************************************************************
//PROGRAMMING PARAMETERS WHICH SHOULD NOT BE CHANGED & UNUSED PARAMETERS

//Runtime class label for instantiation of object.
classLabel = "sensor"

//**********************************************************************
//KEYMAP LABEL
// Obsolete, use hotkeyLabel
// keymapLabel = "borg_gate"
hotkeyLabel = "HOTKEY_F10"

// used for formations AND admiral's log to see if something is non-combat
shipType = "N"

animation = 2




// Xaramada resource costs: original filename.
dilithiumCost = 5000
metalCost = 5000
latinumCost = 0
biomatterCost = 0
crewCost = 1000
officerCost = 5
buildTime = 375
