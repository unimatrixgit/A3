maxLatinum = 0

// Doesn't mention "cargo Bays"
eventSelect = "DataSelect"




// Xaramada resource costs: original filename.
dilithiumCost = 150
metalCost = 150
latinumCost = 0
biomatterCost = 0
crewCost = 100
officerCost = 0
buildTime = 40
