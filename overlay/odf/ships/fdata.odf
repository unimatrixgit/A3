//**********************************************************************
//SHIP NAMES

//Possible Craft Names
possibleCraftNames = "EP-3"
	 
//**********************************************************************
//ART PARAMETERS & WEAPON NAMES


// Hardpoints to hit for various systems and other locations.
enginesTargetHardpoints = "hp01" "hp02"
lifeSupportTargetHardpoints = "hp03" "hp04"
weaponsTargetHardpoints =
shieldGeneratorTargetHardpoints = "hp05" "hp06" "hp07"
sensorsTargetHardpoints = "hp08" "hp09"
hullTargetHardpoints = "hp03" "hp04"
criticalTargetHardpoints = "hp08" "hp09"

//**********************************************************************

baseName = "fdata"

miner = 0

