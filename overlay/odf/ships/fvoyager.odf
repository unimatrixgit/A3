#include "cruise3.odf"

//Name of Ship class in Ship Display window & in edit mode & tooltip
unitName = "Intrepid Class"

//tooltips
tooltip = "Intrepid Class - Destroyer"
verboseTooltip = "Captain Janeway's Voyager"
//This ship is a hero.
isHero = 1

//Ship label provided because this is a unique ship.
label = "USS Voyager NCC-74656"

//Race which can build ship & starting race of ship
race = "federation"

//Amount of time required to build ship

//Number of officers required to build this ship

//Number of crew required to build ship & Starting crew

//Dilithium Cost to build

//Metal Cost to build

//Max Shield Strength & Begining Shield Strength <500
maxHealth = 6000

// Hitpoints

shieldGeneratorHitPoints = 1475
enginesHitPoints = 1475
weaponsHitPoints = 1475
lifeSupportHitPoints = 1475
sensorsHitPoints = 1475

//Rate at which shield recharges (points per second... we think)
shieldRate = 60

//**********************************************************************
//SHIP NAMES

//Possible Craft Names
possibleCraftNames = 
	"USS Voyager"

//**********************************************************************
//ART PARAMETERS & WEAPON NAMES

// Phaser
weapon1 = "fintrepidphas"
weaponHardpoints1 = "hp01" "hp04" "hp06" "hp07" "hp09" "hp12" "hp14" "hp15" "hp17" "hp20" "hp21"

// Phaser
weapon2 = "fintrepidphas"
weaponHardpoints2 = "hp02" "hp03" "hp05" "hp08" "hp10" "hp11" "hp13" "hp16" "hp18" "hp19" "hp22"

// Phaser
weapon3 = "fintrepidphas"
weaponHardpoints3 = "hp27"

// Photon Torpedo
weapon4 = "ftype6"
weaponHardpoints4 = "hp23" "hp25"

// Photon Torpedo
weapon5 = "ftype6"
weaponHardpoints5 = "hp24" "hp26"

//Self Destruct
weapon6 = "gselfdes"
weaponHardpoints6 = "hp29"

// Towing Beam
weapon7 = "gtracbm"
weaponhardpoints7 = "hp28"

// Hardpoints to hit for various systems and other locations.
enginesTargetHardpoints = "hp06" "hp07" "hp08" "hp09" "hp10"
lifeSupportTargetHardpoints = "hp11" "hp12" "hp13" "hp14" "hp15"
weaponsTargetHardpoints = "hp01" "hp02" "hp03" "hp04" "hp05" "hp26" "hp27" "hp28" "hp29" "hp30" "hp31" "hp32"
shieldGeneratorTargetHardpoints = "hp16" "hp17" "hp18" "hp19" "hp20"
sensorsTargetHardpoints = "hp11" "hp12" "hp13" "hp14" "hp15"
hullTargetHardpoints = "hp06" "hp08" "hp10"  "hp12" "hp14" "hp16"
criticalTargetHardpoints = "hp07" "hp09" "hp11" "hp13" "hp17" "hp19"

//**********************************************************************
//AI system parameters
//These parameters influence how the AI evaluates and compares craft.

//An abstract number that represents how much extra strength must be
//used to attack this craft due to its weapons. 
// (0.0=no weapons, 0.5 = average weapons, 1.0=many good weapons)
attackPower = 0.25f

//The normalized intrinsic value of a target.  High value craft make good
//attack targets. (0.0=lowest value, 1.0=highest value)
intrinsicValue = 0.25f

//**********************************************************************
//CREW STATUS MULTIPLIERS
//The multiplier for the delay between shots for weapons while in yellow status
weaponYellow = 1.0f

//The multiplier for the delay between shots for weapons while in red status
weaponRed = 2.0f
//**********************************************************************

//**********************************************************************
//PHYSICS PARAMETERS

// Scripted 3D Attack paths
attack_path0 = "p2.pth"
attack_path1 = "p3.pth"

//**********************************************************************
//KEYMAP LABEL
// Obsolete, use hotkeyLabel
// keymapLabel = "fed_destroyer"
hotkeyLabel = "HOTKEY_F6"


// let's make this a bit bigger
ScaleSOD = 1.5

baseName = "fvoyager"


//physics file for all other physics stuff
physicsFile = "fdestroyerphys.odf"
trekPhysicsFile = "fdestroyerphys.odf"



// Xaramada resource costs: original matching class.
dilithiumCost = 225
metalCost = 0
latinumCost = 0
biomatterCost = 0
crewCost = 250
officerCost = 8
buildTime = 25

eventSelect = "XV_fvoyager_Select"

eventAcknowledge = "XV_fvoyager_Acknowledge"

eventAttack = "XV_fvoyager_Attack"

eventStop = "XV_fvoyager_Stop"

eventMove = "XV_fvoyager_Move"

eventRepair = "XV_fvoyager_Repair"

eventRedAlert = "XV_fvoyager_RedAlert"

eventYellowAlert = "XV_fvoyager_YellowAlert"

eventGreenAlert = "XV_fvoyager_GreenAlert"

eventTransport = "XV_fvoyager_Transport"

eventSelfDestruct = "XV_fvoyager_SelfDestruct"

eventDecommission = "XV_fvoyager_Decommission"
