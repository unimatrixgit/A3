#include "battle.odf"

//Name of Ship class in Ship Display window & in edit mode & tooltip
unitName = "Borg Cube"

//tooltips
tooltip = "Borg Cube"
verboseTooltip = "A massive cube-shaped spacecraft, the Borg Cube is the largest and most heavily armed Borg vessel known to exist.  These cube ships have a highly decentralized design, having no specific operations center, engineering center or living quarters.  Each Borg Cube is equipped with powerful offensive and defensive weapons systems.  Repairs to damaged Borg Cubes is carried out almost instantaneously.  Each Borg Cube may contain a compliment of up to 2000 Borg Drones.  Borg Cubes are capable of travel at impulse, normal warp and transwarp speeds."

//Race which can build ship & starting race of ship
