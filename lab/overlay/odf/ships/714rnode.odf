enginesHitPoints = 1128
weaponsHitPoints = 1128
lifeSupportHitPoints = 1128
sensorsHitPoints = 1128

//**********************************************************************

// Ship's full throttle forward speed when under impluse power.
combatSpeed = 93
impulseSpeed = 78
warpSpeed = 915

//Rate at which shield recharges (points per second... we think)
