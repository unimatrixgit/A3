#include "station.odf"

//**********************************************************************
//MAIN DESIGN PARAMETERS

//Name of Ship class in Ship Display window & in edit mode & tooltip


//tooltips



//Race which can build ship & starting race of ship
race = "borg"

//Amount of time required to build ship

//Number of officers required to build this ship

//Number of crew required to build ship & Starting crew

//Dilithium Cost to build

//Metal cost to build

//Max Shield Strength & Begining Shield Strength <1000
maxHealth = 2800

//Rate at which shield recharges (points per second... we think)
shieldRate = 6.08

//repair hardpoint is where the bottom boundary of the ship lines up
repairSide = 5

// we don't have a repair facility, though we do have a decommission facility
repairFacility = 0
decommissionFacility = 1

//Possible Craft Names
possibleCraftNames = "AAM99-326497" "AAM99-4894636" "AAM99-808688" "AAM99-868848" "AAM99-453456"

//**********************************************************************
//ART PARAMETERS & WEAPON NAMES


// Hardpoints to hit for various systems and other locations.
enginesTargetHardpoints = "hp01" "hp06" "hp11" "hp16" "hp21"
lifeSupportTargetHardpoints = "hp02" "hp07" "hp12" "hp17" "hp22"
weaponsTargetHardpoints = "hp03" "hp08" "hp13" "hp18" "hp23"
shieldGeneratorTargetHardpoints = "hp04" "hp09" "hp14" "hp19" "hp24"
sensorsTargetHardpoints = "hp05" "hp10" "hp15" "hp19" "hp26"
hullTargetHardpoints = "hp01" "hp06" "hp11" "hp16" "hp21"
criticalTargetHardpoints = "hp01" "hp06" "hp11" "hp16" "hp21"

//**********************************************************************

//Hardpoint location for repair.
repairHardpoint = "repair"

//**********************************************************************
//AI system parameters
//These parameters influence how the AI evaluates and compares craft.

//The normalized intrinsic value of a target.  High value craft make good
//attack targets. (0.0=lowest value, 1.0=highest value)
intrinsicValue = 1.00f

//**********************************************************************
//MESSAGE & SOUND PARAMETERS

eventSelect = "RecyclerSelect"
eventAcknowledge = "RecyclerAcknowledge"
eventDecommission = "RecyclerDecommission"

//**********************************************************************
//PROGRAMMING PARAMETERS WHICH SHOULD NOT BE CHANGED & UNUSED PARAMETERS

//Runtime class label for instantiation of object.
classLabel = "shipyard"

//**********************************************************************
//KEYMAP LABEL
// Obsolete, use hotkeyLabel
// keymapLabel = "adv_shipyard"
hotkeyLabel = "HOTKEY_F12"

//************************************************************
// Brian additions for context sensitive menus
builder_ship = 0
transporter = 1
recycler = 1
SHOW_MOVEMENT_AUTONOMY = 0

// How much metal you get for dilithium and vice versa
recycleExchangeRate = .7

// How well they break down ships.
dilithiumRecyclingFraction = 1
metalRecyclingFraction = 1



// Xaramada resource costs: original filename.




crewCost = 500
officerCost = 5
buildTime = 100

dilithiumCost = 300

metalCost = 200

latinumCost = 0

biomatterCost = 0





recrewRate = 10

unitName = "Collective Recycler"

tooltip = "Collective Recycler"

verboseTooltip = "Collective service. Repairs friendly vessels using its native repair systems."
