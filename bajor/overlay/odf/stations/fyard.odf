#include "station.odf"

//**********************************************************************
//MAIN DESIGN PARAMETERS

//Name of Ship class in Ship Display window & in edit mode & tooltip
unitName = "Algol Class"

//tooltips
tooltip = "Algol Class - Shipyard"
verboseTooltip = "Builds Frigates and Destroyers including Nova, Sabre, Defiant, Intrepid, Norway, Steamrunner, Yeager, Intrepid Refit, Dauntless."

//Race which can build ship & starting race of ship
race = "federation"

//Amount of time required to build ship

//Number of officers required to build this ship

//Number of crew required to build ship & Starting crew

//Dilithium Cost to build

//Metal cost to build

//Max Shield Strength & Begining Shield Strength <1000
maxHealth = 1000

//Rate at which shield recharges (points per second... we think)
shieldRate = 10

//Even though we are a shipyard we don't have a repair facility
repairFacility = 0
decommissionFacility = 0

//Possible Craft Names
possibleCraftNames = 
	"Barisa Prime" "Tau Ceti Prime" "Tessen Prime" "Taurus Prime"
	"Meldrar Prime" "Moriya Prime" "Erabus Prime" "Finnea Prime"
	"Acamar Prime" "Aldea Prime" "Andoria Prime" "Calder Prime"
	"Iyaar Prime" "Denocet Prime" "Dytallix Prime" "Galor Prime"
	"Minos Prime" "Nausicaa Prime" "Oyarsa Prime" "Qualor Prime" 

//**********************************************************************
//ART PARAMETERS & WEAPON NAMES

// Hardpoints to hit for various systems and other locations.

//**********************************************************************


//**********************************************************************
//Construction Parameters

//Hardpoint location for building.
buildHardpoint = "hp01"

//**********************************************************************
//**********************************************************************
//AI system parameters
//These parameters influence how the AI evaluates and compares craft.

//The normalized intrinsic value of a target.  High value craft make good
//attack targets. (0.0=lowest value, 1.0=highest value)
intrinsicValue = 1.00f


//**********************************************************************


//**********************************************************************
//MESSAGE & SOUND PARAMETERS
//**********************************************************************

eventSelect = "ShipyardSelect"
eventAcknowledge = "ShipyardAcknowledge"
eventDecommission = "ShipyardDecommission"


//**********************************************************************
//PROGRAMMING PARAMETERS WHICH SHOULD NOT BE CHANGED & UNUSED PARAMETERS

//Runtime class label for instantiation of object.
classLabel = "shipyard"

// Hotkey label
hotkeyLabel = "HOTKEY_F2"

//************************************************************
// Brian additions for context sensitive menus
builder_ship = 1
transporter = 1
SHOW_MOVEMENT_AUTONOMY = 1
SHOW_SW_AUTONOMY = 1

// make it bigger
ScaleSOD = 1.50


buildItem0 = "fnova"
buildItem1 = "fdestroy2"
buildItem2 = "fdestroy"
buildItem3 = "fcruise3"
buildItem4 = "fcruise2"
buildItem5 = "fassault"
buildItem6 = "fnorway"
buildItem7 = "fintx"
buildItem8 = "fdauntless"


// Xaramada resource costs: original filename.
dilithiumCost = 100
metalCost = 500
latinumCost = 0
biomatterCost = 0
crewCost = 500
officerCost = 5
buildTime = 25

baseName = "xvstock_fyard"

enginestargethardpoints = "hp01" "hp02" "hp08" 

lifesupporttargethardpoints = "hp01" "hp02" "hp08"

weaponstargethardpoints = "hp01" "hp02" "hp08"

shieldgeneratortargethardpoints = "hp01" "hp02" "hp08"

sensorstargethardpoints = "hp01" "hp02" "hp08"

hulltargethardpoints = "hp03" "hp09" "hp10" "hp11" "hp12" "hp13" "hp14"

criticaltargethardpoints = "hp08" "hp09"
