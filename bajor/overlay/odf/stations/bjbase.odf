//Maximum number of officer quarters
maximumUpgrades = 6

//Max Shield Strength & Begining Shield Strength <1000
maxHealth = 5000

//Rate at which shield recharges (points per second... we think)
shieldRate = 50

//Shield absorbs all damage until it's gone
shieldProtection = 1.0

// Rate at which latinum is transfered from freighters
latinumTransferRate = 15.0

//play animation forward  open up the facility  when construction is finished
animation = 1

//we have an animation when we build a ship
buildAnimation = 1

//Even though we are a shipyard we don't have a repair facility
repairFacility = 0

//scan range in meters
rangeScan = 1000.0f

