weapon2 = "fbpulse"
weaponHardpoints2 = "hp201" 

// Pulse Phaser
weapon3 = "fbpulse"
weaponHardpoints3 = "hp202"

// Pulse Phaser
weapon4 = "fbpulse"
weaponHardpoints4 = "hp203"

// Pulse Phaser
weapon5 = "fbpulse"
weaponHardpoints5 = "hp204"

// Pulse Phaser
weapon6 = "fbpulse"
weaponHardpoints6 = "hp205"

// Pulse Phaser
weapon7 = "fbpulse"
