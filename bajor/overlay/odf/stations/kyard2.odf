hulltargethardpoints = "hp01" "hp02" "hp03" "hp04"

criticaltargethardpoints = "hp01" "hp02" "hp05"





latinumCost = 0

biomatterCost = 0

tooltip = "Shipyard (Imperial Shipyard)"



buildItem0 = "kfrigate"

