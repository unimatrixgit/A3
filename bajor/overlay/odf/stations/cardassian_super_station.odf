#include "station.odf"

//**********************************************************************
//MAIN DESIGN PARAMETERS

//Name of Ship class in Ship Display window & in edit mode & tooltip
unitName = "Advanced Robotics Institute"

//tooltips



//Race which can build ship & starting race of ship
race = "cardassian"

//Amount of time required to build ship

//Number of officers required to build this ship

//Number of crew required to build ship & Starting crew

//Dilithium Cost to build

//Metal cost to build

//Max Shield Strength & Begining Shield Strength <1000
maxHealth = 4961

//Rate at which shield recharges (points per second... we think)
shieldRate = 4.6

//Even though we are a shipyard, we don't have a repair facility
repairFacility = 0
decommissionFacility = 0

//play animation forward (open up the facility) when construction is finished
animation = 1

//we have an animation when we build a ship
buildAnimation = 1

//Possible Craft Names
possibleCraftNames = "Dar'Heel-09" "Dar'Heel-23"

//**********************************************************************
//ART PARAMETERS & WEAPON NAMES

// Hardpoints to hit for various systems and other locations.
enginesTargetHardpoints = "hp06" "hp07" "hp08" "hp09" "hp10"
lifeSupportTargetHardpoints = "hp11" "hp12" "hp13" "hp14" "hp15"
weaponsTargetHardpoints = "hp01" "hp02" "hp03" "hp04" "hp05"
shieldGeneratorTargetHardpoints = "hp16" "hp17" "hp18" "hp19" "hp20"
sensorsTargetHardpoints = "hp21" "hp22" "hp23" "hp24" "hp25"
hullTargetHardpoints = "hp06"
criticalTargetHardpoints = "hp01"

//**********************************************************************
//Construction Parameters
buildItem0 = "csuper"

//Hardpoint location for building.
buildHardpoint = "build"

//**********************************************************************
//AI system parameters
//These parameters influence how the AI evaluates and compares craft.


//The normalized intrinsic value of a target.  High value craft make good
//attack targets. (0.0=lowest value, 1.0=highest value)
intrinsicValue = 1.50f

//SYSTEM HITPOINTS

// Hitpoints

shieldGeneratorHitPoints = 952
enginesHitPoints = 0
weaponsHitPoints = 0
lifeSupportHitPoints = 994
sensorsHitPoints = 1000

//**********************************************************************
//MESSAGE & SOUND PARAMETERS

eventSelect = "SuperblSelect"
eventAcknowledge = "SuperblAcknowledge"
eventDecommission = "SuperblDecommission"

//**********************************************************************
//PROGRAMMING PARAMETERS WHICH SHOULD NOT BE CHANGED & UNUSED PARAMETERS

//Runtime class label for instantiation of object.
classLabel = "shipyard"


//**********************************************************************
//KEYMAP LABEL
// Obsolete, use hotkeyLabel
// keymapLabel = "advanced_research_institute"
hotkeyLabel = "HOTKEY_F10"

//************************************************************
// Brian additions for context sensitive menus
builder_ship = 1
transporter = 1
SHOW_MOVEMENT_AUTONOMY = 0
alert = 0



// Xaramada resource costs: original filename.




crewCost = 300
officerCost = 20
buildTime = 150









dilithiumCost = 0

metalCost = 1250

latinumCost = 1250

biomatterCost = 0

tooltip = "Production Facility (Advanced Robotics Institute)"



verboseTooltip = "Advanced Robotics Institute\nShip construction\nA stronghold of the Cardassian Union."

baseName = "vr26_cardassian_super_station"
