#include "station.odf"

//**********************************************************************
//MAIN DESIGN PARAMETERS

//Name of Ship class in Ship Display window & in edit mode & tooltip


//tooltips



//Race which can build ship & starting race of ship
race = "species8472"

// This ship is evolved from another ship
shipIsBuiltByEvolution = 1

//Dilithium transfer rate from freighter to station
dilithiumTransferRate = 15.0

//Amount of time required to build ship

//Number of officers required to build this ship

// amount of biomatter needed to build

//Max Shield Strength & Begining Shield Strength <1000
maxHealth = 3800

//Rate at which shield recharges (points per second... we think)
shieldRate = 3.9

//**********************************************************************
//Construction Parameters







//Hardpoint location for building.
buildHardpoint = "hp01"

// The wormhole it uses to put them through
wormhole = "fluidicrift2.odf"

//**********************************************************************
//ART PARAMETERS & WEAPON NAMES

// Hardpoints to hit for various systems and other locations.
//enginesTargetHardpoints = "hp02" "hp03" "hp04" "hp05" "hp06"
//lifeSupportTargetHardpoints = "hp02" "hp03" "hp04" "hp05" "hp06"
//weaponsTargetHardpoints = "hp02" "hp03" "hp04" "hp05" "hp06"
shieldGeneratorTargetHardpoints = "hp02" "hp03" "hp04" "hp05" "hp06"
sensorsTargetHardpoints = "hp02" "hp03" "hp04" "hp05" "hp06"
hullTargetHardpoints = "hp02" "hp03" "hp04" "hp05" "hp06"
criticalTargetHardpoints ="hp02" "hp03" "hp04" "hp05" "hp06"

//**********************************************************************
//AI system parameters
//These parameters influence how the AI evaluates and compares craft.


//The normalized intrinsic value of a target.  High value craft make good
//attack targets. (0.0=lowest value, 1.0=highest value)
intrinsicValue = 1.50f

//**********************************************************************
//MESSAGE & SOUND PARAMETERS

eventSelect = "ShipyardSelect"
eventAcknowledge = "ShipyardAcknowledge"
eventDecommission = "ShipyardDecommission"

//**********************************************************************
//KEYMAP LABEL
// Obsolete, use hotkeyLabel
// keymapLabel = "fluid_gate"


//Runtime class label for instantiation of object.
classLabel = "shipyard"

//************************************************************
// Brian additions for context sensitive menus
builder_ship = 1
transporter = 0
has_crew = 0
SHOW_MOVEMENT_AUTONOMY = 1
SHOW_SW_AUTONOMY = 1

animation = 2
scaleSOD = 2.0




// Xaramada resource costs: original filename.





officerCost = 1


// Lab safety fix: this model has no repair docking node. Do not accept repair orders, including after capture.
repairFacility = 0













buildItem0 = "mrc000"

buildItem1 = "mrc001"

buildItem2 = "mrc054"

buildItem3 = "mrc055"

buildItem4 = "mrc056"

buildItem5 = "mrc057"

dilithiumCost = 0

metalCost = 0

latinumCost = 0

biomatterCost = 1000

baseName = "mry8472"







buildTime = 100


hotkeyLabel = "HOTKEY_F7"

crewCost = 0

maximumCrew = 0

unitName = "Species8472 Mirror Universe Yard"

tooltip = "Species8472 Mirror Universe Yard"

verboseTooltip = "Fluidic service. Constructs the vessels available in its production menu."
