//Name of the ODF file for the ordinance for this weapon
ordName = "holdbm"

//Display name for this weapon

//tooltips

//Location of the button in the speed panel

// location of the button in the popup palette

// Priority of button in the speed panel, this is only
// used if it is non-zero.
buttonPriority = 10

//Type of border to use for this button.
//0 = No border.
//1 = Offensive border.
//2 = Defensive border.
buttonBorder = 1

//Time Delay between shots
shotDelay = 0.0

// Range within which the weapon will fire.
range = 800.0f

//Sound which is played when the weapon fires
fireSound = "swbhb.wav"

//Programming Stuff DO NOT CHANGE
classLabel = "toggleweapon"

// Special stuff - denote special weapon
special = 1

// Need target
needTarget = 1

// set target restrictions
targetAlliedCraft = 0
targetAlliedBuildings = 0
targetEnemyCraft = 1
targetEnemyBuildings = 1

// to allow multiple holding beams to be fired at once
// don't check to see if is valid as target
ignoreValidAsTarget = 1

//this special weapon can be assimilated by the borg tech assimilator
//assimilatable = "borpod2"

// this should NOT start attacking when we use it
switchToAttack = 0

// Separate green holding/boarding beam; blue auto-assimilation beam is retained.
wpnName = "Green Holding / Assimilation Beam"












tooltip = "Green Assimilation Beam"

verboseTooltip = "Holds an enemy vessel and transports Borg boarding parties."

buttonSlot = 1

popupSlot = 1

hotkeyLabel = "HOTKEY_F11"
