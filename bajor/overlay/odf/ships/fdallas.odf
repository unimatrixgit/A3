weaponHardpoints1 = "hp41"

// Tri-Cobolt Torpedo
weapon2 = "ftrict"
weaponHardpoints2 = "hp42"

// Type XI Phaser
weapon3 = "fc11phas"
weaponHardpoints3 = "hp30" "hp31" "hp32" "hp33" "hp34" "hp35" 

// Hardpoints to hit for various systems and other locations.
enginesTargetHardpoints = "hp01" "hp02" "hp03" "hp04"
lifeSupportTargetHardpoints = "hp05" "hp06"
weaponsTargetHardpoints = "hp07" "hp08" "hp09" "hp10"
shieldGeneratorTargetHardpoints = "hp11" "hp12" "hp13" "hp14"
sensorsTargetHardpoints = "hp15" "hp16" "hp17"
hullTargetHardpoints = "hp18" "hp19" "hp20" "hp21" "hp22"
criticalTargetHardpoints = "hp01" "hp02" "hp05" "hp07" "hp09" "hp11" "hp16" "hp19" "hp22"

//**********************************************************************
//AI system parameters
//These parameters influence how the AI evaluates and compares craft.

//An abstract number that represents how much extra strength must be
//used to attack this craft due to its weapons. 
// (0.0=no weapons, 0.5 = average weapons, 1.0=many good weapons)
attackPower = 0.75f

//The normalized intrinsic value of a target.  High value craft make good
//attack targets. (0.0=lowest value, 1.0=highest value)
intrinsicValue = 0.30f

//**********************************************************************
//CREW STATUS MULTIPLIERS
//The multiplier for the delay between shots for weapons while in yellow status
weaponYellow = 1.0f

//The multiplier for the delay between shots for weapons while in red status
weaponRed = 2.0f

//**********************************************************************
//PHYSICS PARAMETERS

physicsFile = "sartilleryshipphys.odf"

//**********************************************************************
//KEYMAP LABEL
// Obsolete, use hotkeyLabel
// keymapLabel = "fed_photon"
hotkeyLabel = "HOTKEY_F8"

// ship type for formations: override the value in cruise2 (not all cruise2s are artillery)
shipType = "A"



// Xaramada resource costs: calculated from original comparable.





officerCost = 7
buildTime = 13

weapon4 = "ya0065"

weaponHardpoints4 = "hp01"

maxSpecialEnergy = 1200









tooltip = "Cruiser (Dallas Class)"


dilithiumcost = 470
metalcost = 160
latinumcost = 0
biomattercost = 0
crewCost = 290

