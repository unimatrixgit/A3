#include "station.odf"

//Race which can build ship & starting race of ship
race = "species8472"

// This ship is built from another ship, not a starbase (used by AIP build lists)
//THIS NEVER SHOULD HAVE BEEN TRUEshipIsBuiltByShips = 1

// No, not built by a constructionrig, but built by evolution!
