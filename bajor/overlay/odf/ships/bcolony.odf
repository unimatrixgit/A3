// Obsolete, use hotkeylabel
// keymapLabel = "placeholder"
hotkeyLabel = "HOTKEY_F3"

shieldGeneratorHitPoints = 100
enginesHitPoints = 50
weaponsHitPoints = 100
lifeSupportHitPoints = 150
sensorsHitPoints = 60


//physics file for all other physics stuff
