//sensorsTargetHardpoints = "hp10" "hp11" "hp12"
//hullTargetHardpoints = "hp13" "hp14" "hp15" "hp16"
//criticalTargetHardpoints = "hp17" "hp18" "hp19"

//**********************************************************************
