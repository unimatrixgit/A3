#include "craft.odf"

//Name of Ship class in Ship Display window & in edit mode & tooltip
unitName = "Omega Particle"

//tooltips
tooltip = "MISC_OMEGA"
verboseTooltip = "MISC_OMEGA_V"

//This ship is a hero.
isHero = 1

//Race which can build ship & starting race of ship
race = "alien"

//Amount of time required to build ship
buildTime = 10.0

//Number of officers required to build this ship
officerCost = 0

//Number of crew required to build ship & Starting crew
crewCost = 0

//Dilithium Cost to build
dilithiumCost = 10

//Max Shield Strength & Begining Shield Strength <500
maxHealth = 100

// Hitpoints

shieldGeneratorHitPoints = 17
enginesHitPoints = 17
weaponsHitPoints = 25
lifeSupportHitPoints = 17
sensorsHitPoints = 17

//Rate at which shield recharges (points per second... we think)
shieldRate = 1.0

//Maximum Value of Special Energy
maxSpecialEnergy = 0

//Rate at which special energy recharges (points per second... we think)
specialEnergyRate = 0

//**********************************************************************
//SHIP NAMES

//Possible Craft Names
possibleCraftNames = "Omega Particle"


//**********************************************************************
//ART PARAMETERS & WEAPON NAMES

// Towing Beam
//weapon1 = "gtracbm"
//weaponHardpoints1 = "hp01" "hp02" "hp03"


// Hardpoints to hit for various systems and other locations.
enginesTargetHardpoints = "hp01" "hp02" "hp04" "hp05"
lifeSupportTargetHardpoints = "hp01" "hp02" "hp04" "hp05"
weaponsTargetHardpoints = "hp01" "hp02" "hp04" "hp05"
shieldGeneratorTargetHardpoints = "hp01" "hp02" "hp04" "hp05"
sensorsTargetHardpoints = "hp01" "hp02" "hp04" "hp05"
hullTargetHardpoints = "hp01" "hp02" "hp04" "hp05"
criticalTargetHardpoints = "hp01" "hp02" "hp04" "hp05"

//**********************************************************************

//**********************************************************************
//AI system parameters
//These parameters influence how the AI evaluates and compares craft.

//An abstract number that represents how much extra strength must be
//used to attack this craft due to its weapons. 
// (0.0=no weapons, 0.5 = average weapons, 1.0=many good weapons)
attackPower = 0.75f

//The normalized intrinsic value of a target.  High value craft make good
//attack targets. (0.0=lowest value, 1.0=highest value)
intrinsicValue = 0.30f


//**********************************************************************
//SYSTEM DAMAGE DISTRIBUTION
//The following section's values should add up to 100
//Percent Chance out of 100 of engines being destroyed
enginesHitPercent = 0.0f

//Percent Chance out of 100 of life support being destroyed
lifeSupportHitPercent = 0.0f

//Percent Chance out of 100 of weapons being destroyed
weaponsHitPercent = 0.0f

//Percent Chance out of 100 of shields being destroyed
shieldGeneratorHitPercent = 14.0f

//Percent Chance out of 100 of sensors being destroyed
sensorsHitPercent = 15.5f

//Percent Chance out of 100 of hull being hit (crew dying)
crewHitPercent = 15.5f

//Percent Chance out of 100 of entire ship exploding
hullHitPercent = 55.0f
//**********************************************************************


//**********************************************************************

// This is the size of the build animation sparks.
weldingRadius = 0.25

//**********************************************************************

//**********************************************************************
//MESSAGE & SOUND PARAMETERS

//**********************************************************************

physicsFile = "sbattphys.odf"
avoidanceClass = 0

//turns collision avoidance off
avoidMe = 0

//animate looped upon build
animation = 2

//Sound played
ambientSound = "omega.wav"

// ship type for formations
shipType = "X"

eventSelect = "XV_momega_Select"

eventAcknowledge = "XV_momega_Acknowledge"

eventAttack = "XV_momega_Attack"

eventStop = "XV_momega_Stop"

eventMove = "XV_momega_Move"

eventRepair = "XV_momega_Repair"

eventRedAlert = "XV_momega_RedAlert"

eventYellowAlert = "XV_momega_YellowAlert"

eventGreenAlert = "XV_momega_GreenAlert"

eventTransport = "XV_momega_Transport"

eventSelfDestruct = "XV_momega_SelfDestruct"

eventDecommission = "XV_momega_Decommission"
