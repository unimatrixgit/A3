#include "battle.odf"

//Name of Ship class in Ship Display window & in edit mode & tooltip
unitName = "Keldon Class"

//tooltips
tooltip = "CARD_KENTAR"
verboseTooltip = "CARD_KENTAR_V"

//This ship is a hero.
isHero = 1

//Ship label provided because this is a unique ship.
