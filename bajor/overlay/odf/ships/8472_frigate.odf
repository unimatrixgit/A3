#include "frigate.odf"

//MAIN DESIGN PARAMETERS

//Race which can build ship & starting race of ship
race = "species8472"

//Name of Ship class in Ship Display window & in edit mode & tooltip
unitName = "Frigate"

//tooltips



//Can decommission itself anywhere
recyclesInPlace = 1

//Amount of time required to build ship

//Number of officers required to build this ship

// amount of biomatter needed to build this ship

//Max Shield Strength & Begining Shield Strength <500
maxHealth = 2241

// Hitpoints

shieldGeneratorHitPoints = 1589
enginesHitPoints = 1576
weaponsHitPoints = 1588
lifeSupportHitPoints = 1415
sensorsHitPoints = 1502

//**********************************************************************

// Ship's full throttle forward speed when under impluse power.
combatSpeed = 77
impulseSpeed = 78
warpSpeed = 903

//Rate at which shield recharges (points per second... we think)
shieldRate = 6.4

//Maximum Value of Special Energy
maxSpecialEnergy = 3100

//Rate at which special energy recharges (points per second... we think)
specialEnergyRate = 15

//**********************************************************************
//SHIP NAMES

//Possible Craft Names
possibleCraftNames = "Frigate-L7E25" "Frigate-L6B84" "Frigate-L1Y14"

//**********************************************************************
//ART PARAMETERS & WEAPON NAMES

// Phaser
weapon1 = "biolev2"
weaponHardpoints1 = "hp01" "hp02" "hp03" "hp21" "hp22" "hp23"

// Special Weapon - Bio-Pulse Conduit
weapon2 = "gbioPulse"
weaponHardpoints2 = "hp24"

//Hardpoints to hit for various systems and other locations.
enginesTargetHardpoints = "hp05" "hp06" "hp07" "hp08" "hp09" "hp10"
lifeSupportTargetHardpoints = "hp06" "hp08" "hp10" "hp12" "hp14" "hp16" "hp18"
weaponsTargetHardpoints = "hp01" "hp02" "hp03" "hp21" "hp22" "hp23"
shieldGeneratorTargetHardpoints = "hp07" "hp09" "hp11" "hp13" "hp15" "hp17" "hp19"
sensorsTargetHardpoints = "hp10" "hp11" "hp12" "hp13" "hp14" "hp15"
hullTargetHardpoints = "hp07" "hp09" "hp11" "hp13" "hp15" "hp17" "hp19"
criticalTargetHardpoints = "hp06" "hp08" "hp10" "hp12" "hp14" "hp16" "hp18" "hp20"

//**********************************************************************
//AI system parameters
//These parameters influence how the AI evaluates and compares craft.

//An abstract number that represents how much extra strength must be
//used to attack this craft due to its weapons. 
// (0.0=no weapons, 0.5 = average weapons, 1.0=many good weapons)
attackPower = 0.50f

//The normalized intrinsic value of a target.  High value craft make good
//attack targets. (0.0=lowest value, 1.0=highest value)
intrinsicValue = 0.50f

//**********************************************************************
//CREW STATUS MULTIPLIERS
//The multiplier for the delay between shots for weapons while in yellow status
weaponYellow = 1.0f

//The multiplier for the delay between shots for weapons while in red status
weaponRed = 1.0f

//**********************************************************************
//KEYMAP LABEL
// Obsolete, use hotkeyLabel
// keymapLabel = "placeholder"
hotkeyLabel = "HOTKEY_F2"

transporter = 0
can_repair = 0

// ship type for formations.  Though this is a frigate, it doesn't really have 
// special weapons that help it's allies, so move it where you'd put cruisers.
shipType = "C"




// Xaramada resource costs: original filename.





officerCost = 1
buildTime = 24

// Visual size: 150 percent of pre-patch scale.
ScaleSOD = 1.5









tooltip = "Frigate (Frigate)"


dilithiumcost = 0
metalcost = 0
latinumcost = 0
biomattercost = 345
crewCost = 0

verboseTooltip = "Frigate\n8472 Bio-Pulse Conduit\nA living vessel born in fluidic space."
