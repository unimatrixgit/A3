	Sound <federation> "fed_mp_01.wav"
	Sound <klingon> "kling_mp_01.wav"
	Sound <romulan> "rom_mp_01.wav"
	Sound <cardassian> "car_mp_01.wav"
	Sound <species8472> "spe_mp_01.wav"
Text "EVENTS_VICTORY"
}

# the local player was vanquished (that is, another player was victorious, and the local player was not eliminated early)
LocalVanquished{
Table
#	Sound "fed_mp_02.wav"
	Sound <borg> "borg_mp_02.wav"
	Sound <federation> "fed_mp_02.wav"
	Sound <klingon> "kling_mp_02.wav"
	Sound <romulan> "rom_mp_02.wav"
	Sound <cardassian> "car_mp_02.wav"
	Sound <species8472> "spe_mp_02.wav"
Text "EVENTS_FAILURE"
}

# the local player was eliminated early
