	Sound <federation> "fed_mp_03.wav"
	Sound <klingon> "kling_mp_03.wav"
	Sound <romulan> "rom_mp_03.wav"
	Sound <cardassian> "car_mp_03.wav"
	Sound <species8472> "spe_mp_03.wav"
Text "EVENTS_ELIMINATED"
}

